RESEND_API_KEY=
RESEND_TO_EMAIL=hello@thesuitdepot.com
RESEND_FROM_EMAIL="The Suit Depot <onboarding@resend.dev>"
NEXT_PUBLIC_ENABLE_HERO_VIDEO=false

# Live Google reviews (optional). When both are set, the reviews widget pulls
# live ratings/reviews from the Google Places API, cached hourly. When unset,
# it falls back to the curated testimonials in content/testimonials.ts.
# API key: Google Cloud console > Places API. Place ID: find via
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=

# Optional: upgrades the maps from the keyless OpenStreetMap embed to the Google
# Maps Embed API (incl. pre-calculated directions on city pages). Enable the
# "Maps Embed API" in Google Cloud. Maps render fine without this (OSM fallback).
GOOGLE_MAPS_EMBED_KEY=
